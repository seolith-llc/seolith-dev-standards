{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:seolith:tester:manifest:1",
  "title": "Seolith Tester v1 seed manifest",
  "description": "Portable seed catalog. Runtime case revisions and verified authors are assigned by the host; case IDs must be unique within a manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "manifestVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "manifestVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "route",
        "roles",
        "prerequisites",
        "steps",
        "expected",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Stable app-local ID, e.g. OMNI-T01. Never recycle an archived ID for a different case."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$"
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/(?!/)[^\\\\\\u0000]*$",
          "description": "Application-relative route; put fixture IDs and private-link instructions in the steps, not secrets in the URL."
        },
        "roles": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$"
          }
        },
        "prerequisites": {
          "type": "string",
          "maxLength": 8000,
          "pattern": "^[^\\u0000]*$",
          "description": "State fixtures, effective permissions, environment constraints, side effects, and cleanup ownership."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$"
          }
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        }
      }
    }
  }
}
